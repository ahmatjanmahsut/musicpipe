{
  "name": "musicpipe-appservice",
  "version": "0.1.0",
  "private": true,
  "description": "MusicPipe companion app service (auth/users/update/lyrics) + Mock Subsonic",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test test/auth.test.ts test/users.test.ts test/update.test.ts test/lyrics.test.ts test/mock-subsonic.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.0.0",
    "@fastify/multipart": "^8.0.0",
    "@fastify/static": "^7.0.0",
    "better-sqlite3": "^12.2.0",
    "fastify": "^4.28.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}